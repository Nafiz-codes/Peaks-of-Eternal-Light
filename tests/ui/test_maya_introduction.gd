extends SceneTree
func _init() -> void: call_deferred("run")
func run() -> void:
	var session = root.get_node("MissionSession")
	session.confirm_new_commander("commander-01", "Commander")
	session.select_landing_site("ridge_a")
	session.start_selected_mission()
	change_scene_to_file("res://scenes/lunar_outpost_3d.tscn")
	await scene_changed
	var world = current_scene
	var player = world.get_node("Outpost/Astronaut")
	var maya = world.get_node("Outpost/crew_briefing")
	player.set_physics_process(false)
	player.global_position = maya.global_position + Vector3(0, 0, 8)
	world._on_player_interaction("crew_briefing")
	assert(not world.get_node("MissionHUD").crew_dialogue.visible)
	player.global_position = maya.global_position + Vector3(0, 0, 1.8)
	world._on_player_interaction("crew_briefing")
	var menu = world.get_node("MissionHUD").crew_dialogue
	assert(not menu.visible and not session.maya_intro_complete)
	var dialogue = world.get_node("MayaIntroduction")
	assert(world.maya_dialogue_active and dialogue.lines.size() == 3)
	assert(dialogue.lines[0][1] == "smiling" and dialogue.lines[2][1] == "neutral")
	assert(dialogue.view.speech.text.begins_with("Welcome to the Moon."))
	dialogue.advance()
	assert(not session.maya_intro_complete)
	assert(dialogue.view.speech.text == "Where do I start?")
	assert(dialogue.view.portrait.visible)
	dialogue.advance()
	assert(not session.maya_intro_complete)
	dialogue.advance()
	await process_frame
	assert(session.maya_intro_complete and not player.ui_blocked)
	var save = preload("res://src/runtime/mission_save.gd")
	assert(save.decode(save.capture(session)).maya_intro_complete)
	print("PASS: Maya menu, expressions, dialogue sequence, completion and save state")
	quit()
