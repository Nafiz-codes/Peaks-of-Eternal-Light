extends SceneTree
const Driver = preload("res://src/world/rover_drive.gd")
func _init():
	var obstacle := StaticBody3D.new()
	assert(Driver.impact_damage(obstacle, Vector3.BACK, Vector3(0, 0, -2.4)) > 0)
	assert(Driver.impact_damage(obstacle, Vector3.BACK, Vector3(0, -20, -0.2)) == 0)
	assert(Driver.impact_damage(obstacle, Vector3.UP, Vector3(0, -20, -2.4)) == 0)
	var crew := Node3D.new()
	crew.set_meta("crew_id", "engineer")
	crew.add_child(obstacle)
	assert(Driver.impact_damage(obstacle, Vector3.BACK, Vector3(0, 0, -2.4)) == 0)
	crew.remove_child(obstacle)
	obstacle.set_meta("rover_target", "astronaut")
	assert(Driver.impact_damage(obstacle, Vector3.BACK, Vector3(0, 0, -2.4)) == 0)
	obstacle.remove_meta("rover_target")
	obstacle.set_meta("rover_safe_terrain", true)
	assert(Driver.impact_damage(obstacle, Vector3.BACK, Vector3(0, -20, -2.4)) == 0)
	obstacle.free()
	crew.free()
	print("Rover impacts: 6 checks passed")
	quit()
